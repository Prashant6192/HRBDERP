###############################################################################
# HRBD ERP — Environment configuration
#
# Copy to .env and adjust. Never commit a real .env.
# See DEPLOYMENT.md for production values.
###############################################################################

APP_NAME="HRBD ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_TIMEZONE=Asia/Kolkata

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#------------------------------------------------------------------------------
# Database — PostgreSQL is the only supported production database.
#------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hrbderp
DB_USERNAME=hrbderp
DB_PASSWORD=hrbderp_local_dev

#------------------------------------------------------------------------------
# Session / cache / queue
#
# Local development may use the database driver. Production should use Redis
# for cache, queues and locks. See DEPLOYMENT.md.
#------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#------------------------------------------------------------------------------
# File storage
#
# 'local' for development. Production should use 's3' (Amazon S3 / Cloudflare
# R2). ERP documents are private by default and served through signed,
# authorised download routes — never via a public bucket URL.
#------------------------------------------------------------------------------
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

#------------------------------------------------------------------------------
# Mail
#------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="erp@hrbd.local"
MAIL_FROM_NAME="${APP_NAME}"

#------------------------------------------------------------------------------
# ERP — formula (trade secret) security
#
# ERP_FORMULA_ACCESS_TTL_MINUTES: how long a formula-security unlock stays
# valid before the user must re-verify. Admin-configurable at runtime; this is
# the fallback default.
#------------------------------------------------------------------------------
ERP_FORMULA_ACCESS_TTL_MINUTES=20
ERP_FORMULA_REQUIRE_PIN=true

VITE_APP_NAME="${APP_NAME}"
